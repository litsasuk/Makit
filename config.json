{
  "output_dir": "output",

  "console_modes": {
    "recon": {
      "name": "Recon",
      "description": "信息收集、资产发现与攻击面梳理"
    },
    "exploit": {
      "name": "Exploit",
      "description": "特定漏洞攻击脚本和利用工具"
    },
    "scan": {
      "name": "Scan",
      "description": "漏洞扫描工具"
    },
    "gadget": {
      "name": "Gadget",
      "description": "其他好用的小工具"
    },
    "workflow": {
      "name": "Workflow",
      "description": "按顺序执行多个工具的组合流程"
    }
  },

  "tools": {
    "nmap": {
      "module": "nmap",
      "console_mode": "recon",
      "description": "端口与服务探测",
      "executable": "tools\\nmap\\nmap.exe",
      "encoding": "utf-8",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "探测常用的 100 个 TCP 端口",
          "args": [
            "-sT",
            "-Pn",
            "-T4",
            "-sV",
            "--top-ports",
            "100",
            "-oX",
            "{output_dir}\\nmap.xml",
            "{host}"
          ],
          "list_args": [
            "-sT", "-Pn", "-T4", "-sV", "--top-ports", "100",
            "-oX", "{output_dir}\\nmap.xml", "-iL", "{host_file}"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "探测 1-1000 TCP 端口及服务版本",
          "args": [
            "-sT",
            "-Pn",
            "-sV",
            "-p",
            "1-1000",
            "-oX",
            "{output_dir}\\nmap.xml",
            "{host}"
          ],
          "list_args": [
            "-sT", "-Pn", "-sV", "-p", "1-1000",
            "-oX", "{output_dir}\\nmap.xml", "-iL", "{host_file}"
          ]
        },
        "full": {
          "name": "完整",
          "description": "探测全部 TCP 端口及服务版本",
          "args": [
            "-sT",
            "-Pn",
            "-T4",
            "-sV",
            "-p-",
            "-oX",
            "{output_dir}\\nmap.xml",
            "{host}"
          ],
          "list_args": [
            "-sT", "-Pn", "-T4", "-sV", "-p-",
            "-oX", "{output_dir}\\nmap.xml", "-iL", "{host_file}"
          ]
        }
      }
    },
    "httpx": {
      "module": "httpx",
      "console_mode": "recon",
      "description": "Web 存活与技术栈识别",
      "header_args": ["-H", "{header}"],
      "executable": "tools\\httpx\\httpx.exe",
      "encoding": "utf-8",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "获取状态码与页面标题",
          "args": [
            "-u",
            "{target}",
            "-silent",
            "-status-code",
            "-title",
            "-json",
            "-o",
            "{output_dir}\\httpx.jsonl"
          ],
          "list_args": [
            "-l", "{target_file}", "-silent", "-status-code", "-title",
            "-json", "-o", "{output_dir}\\httpx.jsonl"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "获取状态、标题、技术栈、服务器和地址信息",
          "args": [
            "-u",
            "{target}",
            "-status-code",
            "-title",
            "-tech-detect",
            "-server",
            "-ip",
            "-cname",
            "-follow-redirects",
            "-json",
            "-o",
            "{output_dir}\\httpx.jsonl"
          ],
          "list_args": [
            "-l", "{target_file}", "-status-code", "-title", "-tech-detect",
            "-server", "-ip", "-cname", "-follow-redirects", "-json",
            "-o", "{output_dir}\\httpx.jsonl"
          ]
        }
      }
    },
    "dirsearch": {
      "module": "dirsearch",
      "console_mode": "recon",
      "description": "Web 目录与文件发现",
      "header_args": ["-H", "{header}"],
      "script": "tools\\dirsearch\\dirsearch.py",
      "required_files": ["tools\\dirsearch\\dirsearch.py"],
      "encoding": "utf-8",
      "preserve_color": true,
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "低速率执行基础目录发现",
          "args": [
            "-u", "{target}", "-t", "10", "--max-rate", "20",
            "--format", "json",
            "-o", "{output_dir}\\dirsearch.json"
          ],
          "list_args": [
            "-l", "{target_file}", "-t", "10",
            "--max-rate", "20", "--format",
            "json", "-o", "{output_dir}\\dirsearch.json"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "检查常见 Web 文件扩展名",
          "args": [
            "-u", "{target}", "-e", "php,html,js,txt,bak",
            "--format", "json", "-o", "{output_dir}\\dirsearch.json"
          ],
          "list_args": [
            "-l", "{target_file}", "-e",
            "php,html,js,txt,bak",
            "--format", "json",
            "-o", "{output_dir}\\dirsearch.json"
          ]
        },
        "full": {
          "name": "完整",
          "description": "最多递归两层执行目录发现",
          "args": [
            "-u", "{target}", "-e", "php,html,js,txt,bak,zip", "-r",
            "--max-recursion-depth", "2", "-t", "20", "--max-rate", "20",
            "--format", "json",
            "-o", "{output_dir}\\dirsearch.json"
          ],
          "list_args": [
            "-l", "{target_file}", "-e",
            "php,html,js,txt,bak,zip", "-r", "--max-recursion-depth", "2",
            "-t", "20", "--max-rate", "20",
            "--format", "json", "-o", "{output_dir}\\dirsearch.json"
          ]
        }
      }
    },
    "urlfinder": {
      "module": "urlfinder",
      "console_mode": "recon",
      "description": "URL 与 JavaScript 资源收集",
      "cookie_args": ["-c", "{cookie}"],
      "executable": "tools\\URLFinder\\URLFinder.exe",
      "encoding": "utf-8",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "普通模式抓取，限制最多 5000 条链接",
          "args": [
            "-u", "{target}", "-m", "1", "-t", "20", "-max", "5000",
            "-o", "{output_dir}\\urlfinder.json"
          ],
          "list_args": [
            "-f", "{target_file}", "-m", "1", "-t", "20", "-max", "5000",
            "-o", "{output_dir}\\urlfinder.json"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "安全深入模式抓取 URL 和 JavaScript",
          "args": [
            "-u", "{target}", "-m", "3", "-max", "20000",
            "-o", "{output_dir}\\urlfinder.json"
          ],
          "list_args": [
            "-f", "{target_file}", "-m", "3", "-max", "20000",
            "-o", "{output_dir}\\urlfinder.json"
          ]
        },
        "full": {
          "name": "完整",
          "description": "深入模式抓取，限制最多 50000 条链接",
          "args": [
            "-u", "{target}", "-m", "2", "-t", "40", "-max", "50000",
            "-o", "{output_dir}\\urlfinder.json"
          ],
          "list_args": [
            "-f", "{target_file}", "-m", "2", "-t", "40", "-max", "50000",
            "-o", "{output_dir}\\urlfinder.json"
          ]
        }
      }
    },
    "enscan": {
      "module": "enscan",
      "console_mode": "recon",
      "description": "企业信息收集",
      "executable": "tools\\ENScan\\enscan-v2.0.5-windows-amd64.exe",
      "encoding": "utf-8",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "以域名作为关键词快速查询企业信息",
          "args": [
            "-n", "{host}", "-type", "aqc", "-is-fast", "-json",
            "-out-dir", "{output_dir}"
          ],
          "list_args": [
            "-f", "{host_file}", "-type", "aqc", "-is-fast", "-json",
            "-out-dir", "{output_dir}"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "查询企业、分支机构和控股信息",
          "args": [
            "-n", "{host}", "-type", "aqc", "-deep", "1", "-branch",
            "-hold", "-json", "-out-dir", "{output_dir}"
          ],
          "list_args": [
            "-f", "{host_file}", "-type", "aqc", "-deep", "1", "-branch",
            "-hold", "-json", "-out-dir", "{output_dir}"
          ]
        },
        "full": {
          "name": "完整",
          "description": "递归两层并查询分支、控股和供应商信息",
          "args": [
            "-n", "{host}", "-type", "aqc", "-deep", "2", "-branch",
            "-hold", "-supplier", "-json", "-out-dir", "{output_dir}"
          ],
          "list_args": [
            "-f", "{host_file}", "-type", "aqc", "-deep", "2", "-branch",
            "-hold", "-supplier", "-json", "-out-dir", "{output_dir}"
          ]
        }
      }
    },
    "subfinder": {
      "module": "subfinder",
      "console_mode": "recon",
      "description": "被动子域名发现",
      "executable": "tools\\subfider\\subfinder.exe",
      "encoding": "utf-8",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "使用默认被动数据源发现子域名",
          "args": [
            "-d", "{host}", "-silent", "-rl", "10", "-duc",
            "-o", "{output_dir}\\subdomains.txt"
          ],
          "list_args": [
            "-dL", "{host_file}", "-silent", "-rl", "10", "-duc",
            "-o", "{output_dir}\\subdomains.txt"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "记录来源并输出 JSONL",
          "args": [
            "-d", "{host}", "-oJ", "-cs", "-duc",
            "-o", "{output_dir}\\subdomains.jsonl"
          ],
          "list_args": [
            "-dL", "{host_file}", "-oJ", "-cs", "-duc",
            "-o", "{output_dir}\\subdomains.jsonl"
          ]
        },
        "full": {
          "name": "完整",
          "description": "启用全部数据源和递归数据源",
          "args": [
            "-d", "{host}", "-all", "-recursive", "-oJ", "-cs", "-rl", "20",
            "-duc", "-o", "{output_dir}\\subdomains.jsonl"
          ],
          "list_args": [
            "-dL", "{host_file}", "-all", "-recursive", "-oJ", "-cs", "-rl", "20",
            "-duc", "-o", "{output_dir}\\subdomains.jsonl"
          ]
        }
      }
    },
    "nuclei": {
      "module": "nuclei",
      "console_mode": "scan",
      "description": "模板化漏洞检测",
      "header_args": ["-H", "{header}"],
      "executable": "tools\\nuclei\\nuclei.exe",
      "encoding": "utf-8",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "仅检查高危和严重问题",
          "args": [
            "-u",
            "{target}",
            "-severity",
            "high,critical",
            "-rate-limit",
            "50",
            "-jsonl",
            "-o",
            "{output_dir}\\nuclei.jsonl"
          ],
          "list_args": [
            "-l", "{target_file}", "-severity", "high,critical", "-rate-limit", "50",
            "-jsonl", "-o", "{output_dir}\\nuclei.jsonl"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "检查中危以上问题并排除 dos/fuzz 模板",
          "args": [
            "-u",
            "{target}",
            "-severity",
            "medium,high,critical",
            "-exclude-tags",
            "dos,fuzz",
            "-jsonl",
            "-o",
            "{output_dir}\\nuclei.jsonl"
          ],
          "list_args": [
            "-l", "{target_file}", "-severity", "medium,high,critical",
            "-exclude-tags", "dos,fuzz", "-jsonl",
            "-o", "{output_dir}\\nuclei.jsonl"
          ]
        },
        "full": {
          "name": "完整",
          "description": "检查全部严重级别并限制请求速率",
          "args": [
            "-u",
            "{target}",
            "-rate-limit",
            "10",
            "-exclude-tags",
            "dos,fuzz",
            "-jsonl",
            "-o",
            "{output_dir}\\nuclei.jsonl"
          ],
          "list_args": [
            "-l", "{target_file}", "-rate-limit", "10", "-exclude-tags",
            "dos,fuzz", "-jsonl", "-o", "{output_dir}\\nuclei.jsonl"
          ]
        }
      }
    },
    "sqlmap": {
      "module": "sqlmap",
      "console_mode": "exploit",
      "description": "SQL 注入验证",
      "header_args": ["-H", "{header}"],
      "script": "tools\\sqlmap\\sqlmap.py",
      "required_files": ["tools\\sqlmap\\sqlmap.py"],
      "encoding": "utf-8",
      "preserve_color": true,
      "interactive": true,
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "低等级、低风险的交互式检测",
          "args": [
            "-u", "{target}",
            "--level", "1", "--risk", "1", "--threads", "2", "--timeout", "10",
            "--retries", "1", "--output-dir", "{output_dir}\\sqlmap"
          ],
          "list_args": [
            "-m", "{target_file}",
            "--level", "1", "--risk", "1", "--threads", "2", "--timeout", "10",
            "--retries", "1", "--output-dir", "{output_dir}\\sqlmap"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "标准等级检测表单及一层链接",
          "args": [
            "-u", "{target}",
            "--level", "2", "--risk", "1", "--forms", "--crawl", "1",
            "--timeout", "15", "--retries", "1",
            "--output-dir", "{output_dir}\\sqlmap"
          ],
          "list_args": [
            "-m", "{target_file}",
            "--level", "2", "--risk", "1", "--forms", "--crawl", "1",
            "--timeout", "15", "--retries", "1",
            "--output-dir", "{output_dir}\\sqlmap"
          ]
        },
        "full": {
          "name": "完整",
          "description": "提高检测等级和风险但不执行数据导出",
          "args": [
            "-u", "{target}",
            "--level", "3", "--risk", "2", "--forms", "--crawl", "2",
            "--threads", "3", "--timeout", "20", "--retries", "2",
            "--output-dir", "{output_dir}\\sqlmap"
          ],
          "list_args": [
            "-m", "{target_file}",
            "--level", "3", "--risk", "2", "--forms", "--crawl", "2",
            "--threads", "3", "--timeout", "20", "--retries", "2",
            "--output-dir", "{output_dir}\\sqlmap"
          ]
        }
      }
    },
    "shiro_attack": {
      "module": "shiro_attack",
      "console_mode": "exploit",
      "description": "Shiro Attack 图形化安全检测工具",
      "jar": "tools\\shiro\\shiro_attack-5.1.1-zulu-8-jfx.jar",
      "java_executable": "C:\\Program Files\\Java\\jre1.8.0_271\\bin\\java.exe",
      "encoding": "utf-8",
      "launch_only": true,
      "run_as_admin": false,
      "default_mode": "standard",
      "modes": {
        "standard": {
          "name": "启动",
          "description": "打开 Shiro Attack 图形界面",
          "args": []
        }
      }
    },
    "afrog": {
      "module": "afrog",
      "console_mode": "scan",
      "description": "Web 漏洞验证",
      "header_args": ["-H", "{header}"],
      "executable": "tools\\afrog\\afrog.exe",
      "encoding": "utf-8",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "低并发检查高危和严重问题",
          "args": [
            "-t", "{target}", "-S", "high,critical", "-c", "5", "-rl", "20",
            "-doh", "-j", "{output_dir}\\afrog.json", "-duc"
          ],
          "list_args": [
            "-T", "{target_file}", "-S", "high,critical", "-c", "5", "-rl", "20",
            "-doh", "-j", "{output_dir}\\afrog.json", "-duc"
          ]
        },
        "standard": {
          "name": "标准",
          "description": "检查中危以上问题",
          "args": [
            "-t", "{target}", "-S", "medium,high,critical",
            "-doh", "-j", "{output_dir}\\afrog.json", "-duc"
          ],
          "list_args": [
            "-T", "{target_file}", "-S", "medium,high,critical",
            "-doh", "-j", "{output_dir}\\afrog.json", "-duc"
          ]
        },
        "full": {
          "name": "完整",
          "description": "运行全部内置 PoC 并限制请求速率",
          "args": [
            "-t", "{target}", "-c", "10", "-rl", "20", "-doh",
            "-j", "{output_dir}\\afrog.json", "-duc"
          ],
          "list_args": [
            "-T", "{target_file}", "-c", "10", "-rl", "20", "-doh",
            "-j", "{output_dir}\\afrog.json", "-duc"
          ]
        }
      }
    },
    "xray": {
      "module": "xray",
      "console_mode": "scan",
      "description": "Web 漏洞扫描与爬虫检测",
      "executable": "tools\\xray\\xray_windows_amd64.exe",
      "required_files": ["tools\\xray\\config.yaml"],
      "working_directory": "tools\\xray",
      "encoding": "utf-8",
      "native_terminal": true,
      "modes": {
        "direct": {
          "name": "直接扫描",
          "description": "扫描单个 URL 或 TXT URL 列表",
          "default": true,
          "args": [
            "webscan", "--url", "{target}",
            "--html-output", "{output_dir}\\xray-direct.html",
            "--json-output", "{output_dir}\\xray-direct.json"
          ],
          "list_args": [
            "webscan", "--url-file", "{target_file}",
            "--html-output", "{output_dir}\\xray-direct.html",
            "--json-output", "{output_dir}\\xray-direct.json"
          ]
        },
        "basic-crawler": {
          "name": "基础爬虫",
          "description": "使用基础爬虫发现链接并扫描",
          "args": [
            "webscan", "--basic-crawler", "{target}",
            "--html-output", "{output_dir}\\xray-basic-crawler.html",
            "--json-output", "{output_dir}\\xray-basic-crawler.json"
          ]
        },
        "browser-crawler": {
          "name": "浏览器爬虫",
          "description": "使用浏览器爬虫发现动态链接并扫描",
          "args": [
            "webscan", "--browser-crawler", "{target}",
            "--html-output", "{output_dir}\\xray-browser-crawler.html",
            "--json-output", "{output_dir}\\xray-browser-crawler.json"
          ]
        },
        "poc": {
          "name": "PoC 检测",
          "description": "仅使用 phantasm PoC 插件检测 URL",
          "args": [
            "webscan", "--plugins", "phantasm", "--url", "{target}",
            "--html-output", "{output_dir}\\xray-poc.html",
            "--json-output", "{output_dir}\\xray-poc.json"
          ],
          "list_args": [
            "webscan", "--plugins", "phantasm", "--url-file", "{target_file}",
            "--html-output", "{output_dir}\\xray-poc.html",
            "--json-output", "{output_dir}\\xray-poc.json"
          ]
        }
      }
    },
    "goby": {
      "module": "goby",
      "console_mode": "scan",
      "description": "Goby 图形化安全测试平台",
      "executable": "tools\\Goby\\goby-win-x64-2.0.5\\Goby.exe",
      "encoding": "utf-8",
      "launch_only": true,
      "run_as_admin": true,
      "default_mode": "standard",
      "modes": {
        "standard": {
          "name": "启动",
          "description": "打开 Goby 图形界面",
          "args": []
        }
      }
    }
  },
  "workflows": {
    "basic-web": {
      "module": "basic-web",
      "console_mode": "workflow",
      "description": "基础 Web 组合测试流程",
      "default_mode": "standard",
      "modes": {
        "quick": {
          "name": "快速",
          "description": "Nmap 快速探测后执行 httpx 快速探测",
          "steps": [
            {"tool": "nmap", "mode": "quick"},
            {"tool": "httpx", "mode": "quick"}
          ]
        },
        "standard": {
          "name": "标准",
          "description": "标准资产探测并检查高危漏洞",
          "steps": [
            {"tool": "nmap", "mode": "standard"},
            {"tool": "httpx", "mode": "standard"},
            {"tool": "nuclei", "mode": "quick"}
          ]
        },
        "full": {
          "name": "完整",
          "description": "完整端口探测和模板安全检查",
          "steps": [
            {"tool": "nmap", "mode": "full"},
            {"tool": "httpx", "mode": "standard"},
            {"tool": "nuclei", "mode": "full"}
          ]
        }
      }
    }
  }
}
